# ---------------------------------------------------------------- Banco de dados
# PostgreSQL / Supabase (obrigatório em produção). Sem esta variável, o app usa PGlite (Postgres
# embutido) em web/.data/pglite — ideal para desenvolvimento local.
DATABASE_URL=
# DATABASE_SSL=disable          # use "disable" para Postgres local sem TLS
# DATABASE_POOL_MAX=5
# AVERMONT_PGLITE_DIR=.data/pglite   # "memory://" para banco temporário
# AVERMONT_ALLOW_PGLITE=1             # permite PGlite com NODE_ENV=production (somente demonstração)

# ---------------------------------------------------------------- Aplicação
APP_URL=http://localhost:3000
# E-mails (separados por vírgula) que viram administradores ao se cadastrar
AVERMONT_ADMIN_EMAILS=
# Segredo para a tarefa diária /api/cron/daily (Authorization: Bearer <segredo>)
CRON_SECRET=
PRIVACY_CONTACT_EMAIL=

# ---------------------------------------------------------------- IA (server-side; nunca exposta ao navegador)
# Sem chave, a Avermont AI funciona em "modo sem LLM" (mostra os dados recuperados) e a extração de
# cotações por PDF/imagem fica desativada.
ANTHROPIC_API_KEY=
# AVERMONT_AI_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- E-mail transacional (Resend)
RESEND_API_KEY=
EMAIL_FROM="Avermont <no-reply@seu-dominio.com.br>"

# ---------------------------------------------------------------- Dados
# Diretório dos snapshots gerados pelo worker (padrão: web/data)
# AVERMONT_DATA_DIR=
